---
/**
 * Usermaven in cookieless mode — no cookies, so no consent banner. Renders
 * nothing unless this is the production build AND a key is set, so previews
 * and local builds never report page views. Place it inside <head>.
 *
 * Usermaven's script reads its settings from data attributes on its own script
 * tag and starts itself (an `init` call is no longer read). Cookieless is
 * `data-privacy-policy="strict"`; `data-ip-policy="strict"` has Usermaven drop
 * the last part of the visitor's IP address before processing.
 *
 * `src` and `trackingHost` point at a proxy on the site's own domain when the
 * site has one (a Worker route that forwards to t.usermaven.com and
 * events.usermaven.com): the browser then talks to the site only. A relative
 * `trackingHost` ("/um") keeps previews on their own origin.
 *
 * The loader is a plain string injected with set:html. Script content in Astro
 * is raw text: an expression such as {`...`} written inside <script> is emitted
 * literally, which leaves the browser a block holding an unused string. Values
 * go in through JSON.stringify with "<" escaped, so they can never close the tag.
 */
interface Props {
  usermavenKey: string;
  isProduction: boolean;
  /** Where the browser loads Usermaven's script from. */
  src?: string;
  /** Where events go: Usermaven's host, or the site's own proxy path. */
  trackingHost?: string;
}
const {
  usermavenKey,
  isProduction,
  src = 'https://t.usermaven.com/lib.js',
  trackingHost = 'https://events.usermaven.com',
} = Astro.props;
const run = isProduction && usermavenKey !== '';
const js = (value: string) => JSON.stringify(value).replace(/</g, '\\u003c');
const loader =
  '(function(){window.usermaven=window.usermaven||function(){(window.usermavenQ=window.usermavenQ||[]).push(arguments)};' +
  'var s=document.createElement("script");s.defer=!0;' +
  `s.src=${js(src)};` +
  `s.setAttribute("data-key",${js(usermavenKey)});` +
  `s.setAttribute("data-tracking-host",${js(trackingHost)});` +
  's.setAttribute("data-autocapture","true");' +
  's.setAttribute("data-privacy-policy","strict");' +
  's.setAttribute("data-ip-policy","strict");' +
  'var f=document.getElementsByTagName("script")[0];f.parentNode.insertBefore(s,f);})();';
---

{run && <script is:inline set:html={loader} />}

---
/**
 * Everything a page's <head> needs for search and sharing, in one place:
 * favicons, <title> with the site suffix, description, canonical, hreflang
 * pairs, Open Graph + Twitter cards, the schema.org graph and the sitemap link.
 * Render it inside <head>; charset, viewport and font preloads stay with the
 * site's layout because they differ per site.
 *
 * Favicons are expected at /favicon.svg, /favicon-32.png, /apple-touch-icon.png.
 * og:image points at /og/<slug>.png — the share card the kit draws for this page
 * after the build, with og:image:alt as its title (see `ogImages` in the kit's
 * integration options).
 *
 * og:type is "website" unless the page says `ogType="article"`. An article
 * can add `article` (published and modified time, authors, section, tags);
 * they become the article:* tags, and only together with `ogType="article"`.
 * Times are ISO 8601 strings, or Date objects, which become toISOString().
 * The first author also becomes <meta name="author">. Pass the same values
 * the page's schema.org Article node uses, so the two never disagree.
 */
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { ogSlug } from '../lib/og.js';

interface Alternate {
  /** hreflang code, e.g. "en" or "de" */
  hreflang: string;
  /** Absolute or site-relative URL of that language's version */
  href: string;
}

/** Open Graph article data; the names are those of @jdevalk/astro-seo-graph. */
interface ArticleMeta {
  /** article:published_time, e.g. the Article node's datePublished. */
  publishedTime?: string | Date;
  /** article:modified_time, e.g. the Article node's dateModified. */
  modifiedTime?: string | Date;
  /** article:author, one tag each (profile URLs or names); the first is also <meta name="author">. */
  authors?: string[];
  /** article:section */
  section?: string;
  /** article:tag, one tag each. */
  tags?: string[];
}

interface Props {
  /** Page title (also the schema WebPage name), without the site-name suffix. */
  title: string;
  /** SEO <title> override; the visible h1 keeps `title`. */
  seoTitle?: string;
  description?: string;
  siteName: string;
  siteUrl: string;
  /** Open Graph locale, e.g. "en_US". */
  ogLocale: string;
  /** The locale served at the root; becomes hreflang x-default. */
  defaultLocale: string;
  alternates: Alternate[];
  /** schema.org JSON-LD graph (build it with @jdevalk/seo-graph-core). */
  graph?: Record<string, unknown>;
  noindex?: boolean;
  /** Twitter/X handle for the summary card, e.g. "@phonicscore". */
  twitterSite?: string;
  /** false to leave og:image out (e.g. when the kit's cards are switched off). */
  ogImages?: boolean;
  /** og:type; "website" when left out. */
  ogType?: 'website' | 'article';
  /** The article:* tags; used only with ogType="article". */
  article?: ArticleMeta;
}

const {
  title,
  seoTitle,
  description,
  siteName,
  siteUrl,
  ogLocale,
  defaultLocale,
  alternates,
  graph,
  noindex = false,
  twitterSite,
  ogImages = true,
  ogType,
  article,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = ogImages
  ? new URL(`/og/${ogSlug(Astro.url.pathname)}.png`, siteUrl).href
  : undefined;
const seoAlternates = {
  defaultLocale,
  entries: alternates.map((a) => ({ hreflang: a.hreflang, href: new URL(a.href, siteUrl).href })),
};
---

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<Seo
  title={seoTitle ?? title}
  titleTemplate={`%s - ${siteName}`}
  description={description}
  ogImage={ogImage}
  ogImageAlt={seoTitle ?? title}
  ogImageWidth={1200}
  ogImageHeight={630}
  canonical={canonical}
  siteName={siteName}
  locale={ogLocale}
  twitter={twitterSite ? { card: 'summary_large_image', site: twitterSite } : undefined}
  graph={graph}
  alternates={seoAlternates}
  noindex={noindex}
  ogType={ogType}
  article={ogType === 'article' ? article : undefined}
  extraLinks={[
    { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
    { rel: 'sitemap', href: '/sitemap-index.xml' },
  ]}
/>

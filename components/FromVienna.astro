---
/**
 * "From Vienna with music": the sign-off at the bottom of every PhonicScore
 * site. St. Stephen's Cathedral in a circle over the caption.
 *
 * Rebuilt from the 2021 "From Vienna with love" artwork on
 * opensheetmusicdisplay.org so it looks the same everywhere. That caption was
 * live text in DIN Condensed, which only Apple devices have; elsewhere it fell
 * back to a wide serif and was cut off after "VIENNA". The caption is outlined
 * from DIN Condensed Bold with the font's kerning. The original was 13 units
 * high on the 100-wide artwork; "WITH MUSIC" is one letter longer, so the line
 * is set at 12.31 to keep the old width and baseline (Thomas, 2026-10-16). The
 * light shape that painted over the circle behind the cathedral is a mask, so
 * any ground shows through.
 *
 * Two inks, baked into the files like every mark on the stage:
 *   dark ground   <FromVienna />                 dim (#9c9485)
 *   light ground  <FromVienna ink="original" />  the original warm grey (#423e3b)
 * Another ink is a find-and-replace of the one fill colour in the SVG.
 */
import { Image } from 'astro:assets';
import dim from '../assets/from-vienna-with-music-dim.svg';
import original from '../assets/from-vienna-with-music.svg';

interface Props {
  /** `dim` for dark grounds (default), `original` for light ones. */
  ink?: 'dim' | 'original';
  /** Rendered width in px; the height follows the artwork (100 × 83). */
  width?: number;
  class?: string;
}

const { ink = 'dim', width = 100, class: className } = Astro.props;
---

<Image
  src={ink === 'original' ? original : dim}
  alt="From Vienna with music"
  width={width}
  class={className}
/>

{
  "name": "@phonicscore/astro-kit",
  "version": "1.1.0",
  "description": "Shared Astro foundation for PhonicScore websites: one integration preset, the SEO head, content transforms, base styles and the contact-form Worker.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "astro-component",
    "withastro",
    "astro-integration"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lib/*": "./lib/*",
    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./worker/*": "./worker/*",
    "./routes/*": "./routes/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "components",
    "styles",
    "routes",
    "worker",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "astro": "^7.3.2"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.96",
    "@jdevalk/astro-seo-graph": "^2.2.0",
    "@jdevalk/seo-graph-core": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  }
}
